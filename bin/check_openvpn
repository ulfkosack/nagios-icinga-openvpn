#!/usr/bin/env python3
#
# Check if an OpenVPN server runs on a given UDP or TCP port.
#
# SPDX-License-Identifier: MIT
# Copyright (c) 2013-2019 Roland Wolters and contributors (see AUTHORS)
#

import argparse
import binascii
import hashlib
import hmac
import os
import socket
import struct
import sys
import time

P_CONTROL_HARD_RESET_CLIENT_V2 = 7
P_CONTROL_HARD_RESET_SERVER_V2 = 8
MAX_P_CONTROL_SIZE = 128 # TODO: adopt
MAX_CIPHER_KEY_LENGTH = 64
MAX_HMAC_KEY_LENGTH = 64
BUFFER_SIZE = 1024
# tls-crypt: AES-256-CTR und HMAC-SHA256, siehe openvpn "src/openvpn/tls_crypt.c"
TLS_CRYPT_KEY_LENGTH = 32
TLS_CRYPT_TAG_SIZE = 32
TLS_CRYPT_HEADER_SIZE = 1 + 8 + 4 + 4 # opcode, session id, packet id, net time

ALGORITHMS_AVAILABLE = hashlib.algorithms_available

def ok(msg):
    print(f'OK: {msg}')
    return 0

def warning(msg):
    print(f'WARN: {msg}')
    return 1

def critical(msg):
    print(f'CRIT: {msg}')
    return 2

def build_p_control_hard_reset_client_v2(sid, digest, key):
    # see openvpn source code "src/openvpn/crypto.c" function openvpn_decrypt_v1
    pid = 1 # packet id
    ts = int(time.time())  # net time

    # build packet
    result = b''
    result += struct.pack('>B', P_CONTROL_HARD_RESET_CLIENT_V2 << 3) # packet type
    result += sid # session id
    if key:
        # generate hmac
        h = hmac.new(key, digestmod=digest)
        h.update(struct.pack('>I', pid)) # packet id
        h.update(struct.pack('>I', ts)) # net time
        h.update(struct.pack('>B', P_CONTROL_HARD_RESET_CLIENT_V2 << 3)) # packet type
        h.update(sid) # session id
        h.update(struct.pack('>B', 0)) # message packet id array length
        h.update(struct.pack('>I', 0)) # message packet id
        result += h.digest() # hmac
        result += struct.pack('>I', pid) # packet id
        result += struct.pack('>I', ts) # net time
    result += struct.pack('>B', 0) # message packet id array length
    result += struct.pack('>I', 0) # message packet id
    return result

def validate_p_control_hard_reset_server_v2(packet, query_sid, digest, digest_size, key):
    # see openvpn source code "src/openvpn/crypto.c" function openvpn_decrypt_v1
    # identify packet
    def layout_matches(mpidlen_offset, base_length):
        # Passt die Paketlänge zur ACK-Länge an dieser Stelle? Zu kurze Pakete passen nie.
        if len(packet) <= mpidlen_offset: return False
        return len(packet) - packet[mpidlen_offset] * 4 == base_length
    layouts = [
        (0, 9, 14), # type sid mpida mpid
        (1, 9, 22), # type sid mpida rsid mpid
        (2, 17 + digest_size, 30 + digest_size), # type sid hmac pid ts mpida rsid mpid
    ]
    # Mit Schlüssel zuerst die Variante mit HMAC prüfen: Byte 9 ist dort das erste
    # HMAC-Byte und kann sonst zufällig wie eine passende ACK-Länge aussehen.
    if key: layouts.insert(0, layouts.pop())
    for plen, mpidlen_offset, base_length in layouts:
        if layout_matches(mpidlen_offset, base_length): break
    else: return 20

    # parse packet
    # Vorbelegung für Felder, die nur bei plen >= 1 bzw. >= 2 im Paket stehen
    phmac = rsid = b''
    pid = ts = 0
    ptype = struct.unpack('>B', packet[:1])[0] # packet type
    packet = packet[1:]
    sid = packet[:8] # session id
    packet = packet[8:]
    if plen >= 2:
        phmac = packet[:digest_size] # hmac
        packet = packet[digest_size:]
        pid = struct.unpack('>I', packet[:4])[0] # packet id
        packet = packet[4:]
        ts = struct.unpack('>I', packet[:4])[0] # net time
        packet = packet[4:]
    mpidlen = struct.unpack('>B', packet[:1])[0] # message packet id array length
    packet = packet[1:]
    mpidarray = [] # packet id array
    for _ in range(mpidlen):
        mpidarray.append(struct.unpack('>I', packet[:4])[0]) # message packet id array element
        packet = packet[4:]
    if plen >= 1:
        rsid = packet[:8] # remote session id
        packet = packet[8:]
    mpid = struct.unpack('>I', packet[:4])[0] # message packet id

    # validate packet
    if ptype != P_CONTROL_HARD_RESET_SERVER_V2 << 3: return 20
    if mpid != 0: return 20
    if plen >= 1 and rsid != query_sid: return 20
    if plen >= 2 and key:
        if pid != 1: return 20
        # generate hmac
        h = hmac.new(key, digestmod=digest)
        h.update(struct.pack('>I', pid)) # packet id
        h.update(struct.pack('>I', ts)) # net time
        h.update(struct.pack('>B', ptype)) # packet type
        h.update(sid) # session id
        h.update(struct.pack('>B', mpidlen)) # message packet id array length
        for e in mpidarray: h.update(struct.pack('>I', e)) # message packet id array element
        h.update(rsid) # remote session id
        h.update(struct.pack('>I', mpid)) # message packet id
        if phmac != h.digest(): return 10
        return 1
    return 0

def aes256_ctr(key, iv, data):
    # Erst hier importieren, damit "cryptography" nur für --tls-crypt nötig ist
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    cipher = Cipher(algorithms.AES(key), modes.CTR(iv)).encryptor()
    return cipher.update(data) + cipher.finalize()

def tls_crypt_keys(key):
    # Der Client nutzt bei tls-crypt immer die inverse Richtung:
    # senden mit Schlüssel 1, empfangen mit Schlüssel 0 (je 64 Byte Cipher + 64 Byte HMAC)
    def part(index, offset):
        start = index * (MAX_CIPHER_KEY_LENGTH + MAX_HMAC_KEY_LENGTH) + offset
        return key[start:start + TLS_CRYPT_KEY_LENGTH]
    send = (part(1, 0), part(1, MAX_CIPHER_KEY_LENGTH))
    recv = (part(0, 0), part(0, MAX_CIPHER_KEY_LENGTH))
    return send, recv

def build_tls_crypt_hard_reset_client_v2(sid, keys):
    # see openvpn source code "src/openvpn/tls_crypt.c" function tls_crypt_wrap
    cipher_key, hmac_key = keys
    header = struct.pack('>B', P_CONTROL_HARD_RESET_CLIENT_V2 << 3) # packet type
    header += sid # session id
    header += struct.pack('>I', 1) # packet id
    header += struct.pack('>I', int(time.time())) # net time
    plaintext = struct.pack('>B', 0) # message packet id array length
    plaintext += struct.pack('>I', 0) # message packet id
    tag = hmac.new(hmac_key, header + plaintext, hashlib.sha256).digest()
    return header + tag + aes256_ctr(cipher_key, tag[:16], plaintext)

def validate_tls_crypt_hard_reset_server_v2(packet, query_sid, keys):
    # see openvpn source code "src/openvpn/tls_crypt.c" function tls_crypt_unwrap
    # Rückgabe wie validate_p_control_hard_reset_server_v2: 1 = ok mit HMAC, 10 = HMAC falsch, 20 = ungültig
    cipher_key, hmac_key = keys
    if len(packet) < TLS_CRYPT_HEADER_SIZE + TLS_CRYPT_TAG_SIZE + 5: return 20
    if packet[0] != P_CONTROL_HARD_RESET_SERVER_V2 << 3: return 20
    header = packet[:TLS_CRYPT_HEADER_SIZE]
    tag = packet[TLS_CRYPT_HEADER_SIZE:TLS_CRYPT_HEADER_SIZE + TLS_CRYPT_TAG_SIZE]
    plaintext = aes256_ctr(cipher_key, tag[:16], packet[TLS_CRYPT_HEADER_SIZE + TLS_CRYPT_TAG_SIZE:])
    if not hmac.compare_digest(tag, hmac.new(hmac_key, header + plaintext, hashlib.sha256).digest()):
        return 10
    # Klartext: Länge des ACK-Arrays, ACKs, ggf. remote session id, message packet id
    mpidlen = plaintext[0]
    offset = 1 + 4 * mpidlen
    if mpidlen:
        if plaintext[offset:offset + 8] != query_sid: return 20
        offset += 8
    if len(plaintext) < offset + 4: return 20
    if struct.unpack('>I', plaintext[offset:offset + 4])[0] != 0: return 20
    return 1

def check(host, port, tcp, timeout, digest, digest_size, client_key, server_key, retrycount, validate, family=socket.AF_UNSPEC, tls_crypt=None):
    sid = os.urandom(8) # session id
    if tls_crypt:
        packet = build_tls_crypt_hard_reset_client_v2(sid, tls_crypt[0])
    else:
        packet = build_p_control_hard_reset_client_v2(sid, digest, client_key)
    query_server = query_tcp_server if tcp else query_udp_server

    try:
        s, addr = create_socket(host, port, tcp, timeout, family)
    except socket.gaierror:
        return critical('Unable to resolve host')
    except OSError:
        return critical('Unable to create socket')

    try:
        response = query_server(s, addr, packet, retrycount)
    except RuntimeError:
        return critical('Invalid response')
    except (OSError, struct.error):
        return critical('Not responding')
    finally:
        s.close()

    if response is None:
        return critical('Not responding')

    # for debugging purpose
    # response = binascii.hexlify(response)
    if not validate: return ok('Responded')
    if tls_crypt:
        valid = validate_tls_crypt_hard_reset_server_v2(response, sid, tls_crypt[1])
    else:
        valid = validate_p_control_hard_reset_server_v2(response, sid, digest, digest_size, server_key)
    if valid == 0: return ok('Response validated')
    if valid == 1: return ok('Response validated, checked HMAC')
    if valid == 10: return warning('Invalid HMAC')
    return critical('Invalid response')

def create_socket(host, port, tcp, timeout, family=socket.AF_UNSPEC):
    # thanks to glucas for the idea
    # family: AF_INET (-4), AF_INET6 (-6) oder AF_UNSPEC (erste aufgelöste Adresse)
    sock_type = socket.SOCK_STREAM if tcp else socket.SOCK_DGRAM
    af, socktype, proto, _canonname, sa = socket.getaddrinfo(host, port, family, sock_type)[0]
    s = socket.socket(af, socktype, proto)
    s.settimeout(timeout)
    # Die aufgelöste Adresse zurückgeben, damit sendto/connect nicht neu auflösen
    return s, sa

def query_udp_server(s, addr, packet, retrycount):
    # Send up to 'retrycount' UDP packets with 'timeout' secs between each.
    # Return data after receiving first UDP packet.
    for _ in range(retrycount):
        try:
            s.sendto(packet, addr)
            # TODO: check response address
            data, _ = s.recvfrom(BUFFER_SIZE)
            return data
        except socket.timeout:
            pass
        except OSError:
            return None
    return None

def query_tcp_server(s, addr, packet, retrycount):
    # ignore retrycount
    s.connect(addr)
    s.send(struct.pack('>H', len(packet)) + packet)
    length = struct.unpack('>H', s.recv(2))[0]
    if length > MAX_P_CONTROL_SIZE: raise RuntimeError
    data = s.recv(length)
    if len(data) != length: raise RuntimeError
    return data

def readkey(path):
    try:
        with open(path) as myfile: key = myfile.read()
    except (OSError, UnicodeDecodeError):
        return None
    index_start = key.find('-\n')
    index_end = key.find('\n-', index_start)
    if index_start < 0 or index_end < 0 or index_end <= index_start:
        return None
    index_start += 2
    key = key[index_start:index_end].replace('\n', '').replace('\r', '')
    try:
        return binascii.unhexlify(key)
    except (binascii.Error, ValueError):
        return None

def optionsparser(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument('-p', '--port', help='set port number (default is %(default)d)', type=int, default=1194)
    parser.add_argument('-t', '--tcp', help='use tcp instead of udp', action='store_true')
    family = parser.add_mutually_exclusive_group()
    family.add_argument('-4', '--ipv4', dest='family', help='use IPv4 only', action='store_const', const=socket.AF_INET, default=socket.AF_UNSPEC)
    family.add_argument('-6', '--ipv6', dest='family', help='use IPv6 only', action='store_const', const=socket.AF_INET6)
    parser.add_argument('--timeout', help='set timeout in seconds, for udp counted per packet (default is %(default)d)', type=int, default=2)
    parser.add_argument('--digest', help='set digest algorithm (default is "%(default)s")', default='sha1')
    parser.add_argument('--digest-size', help='set HMAC digest size', type=int)
    parser.add_argument('--digest-key-client', help='set client HMAC key')
    parser.add_argument('--digest-key-server', help='set server HMAC key for packet validation')
    parser.add_argument('--tls-auth', help='set tls-auth file')
    # Siehe https://github.com/liquidat/nagios-icinga-openvpn/issues/23
    parser.add_argument('--key-direction', choices=['0', '1', 'bidirectional'],
                        help='tls-auth key direction, use the "key-direction" value of the client config;'
                             ' "bidirectional" if the config has none (default is 1)')
    parser.add_argument('--tls-auth-inverse', help='same as --key-direction 0 (kept for compatibility)', action='store_true')
    # Siehe https://github.com/liquidat/nagios-icinga-openvpn/issues/22
    parser.add_argument('--tls-crypt', help='set tls-crypt file (requires the Python module "cryptography")')
    parser.add_argument('--retrycount', help='number of udp retries before giving up (default is %(default)d)', type=int, default=3)
    parser.add_argument('--no-validation', help='do not validate response', action='store_true')
    parser.add_argument('host', help='the OpenVPN host name or IP')
    return parser.parse_args(argv)

def main(argv=None):
    args = optionsparser(argv)

    if args.digest_size and args.digest_size < 0:
        return critical('digest size must be positive')
    if args.retrycount < 1:
        return critical('retry count must be positive')
    if args.tls_auth and (args.digest_key_client or args.digest_key_server):
        return critical('--tls-auth cannot go with --digest-key')
    if (args.key_direction or args.tls_auth_inverse) and not args.tls_auth:
        return critical('--key-direction and --tls-auth-inverse require --tls-auth')
    if args.tls_auth_inverse and args.key_direction not in (None, '0'):
        return critical('--tls-auth-inverse cannot go with --key-direction ' + args.key_direction)
    key_direction = '0' if args.tls_auth_inverse else (args.key_direction or '1')
    if args.tls_crypt and (args.tls_auth or args.digest_key_client or args.digest_key_server):
        return critical('--tls-crypt cannot go with --tls-auth or --digest-key')

    tls_crypt = None
    if args.tls_crypt:
        try:
            import cryptography  # noqa: F401
        except ImportError:
            return critical('--tls-crypt requires the Python module "cryptography"')
        key = readkey(args.tls_crypt)
        if key is None or len(key) < 2 * (MAX_CIPHER_KEY_LENGTH + MAX_HMAC_KEY_LENGTH):
            return critical('cannot read tls crypt file')
        tls_crypt = tls_crypt_keys(key)

    try:
        client_key = binascii.unhexlify(args.digest_key_client) if args.digest_key_client else None
    except (binascii.Error, ValueError):
        return critical('--digest-key-client is not a valid hex string')
    try:
        server_key = binascii.unhexlify(args.digest_key_server) if args.digest_key_server else None
    except (binascii.Error, ValueError):
        return critical('--digest-key-server is not a valid hex string')
    digest = args.digest
    digest_size = args.digest_size

    digest = digest.lower()
    if digest not in ALGORITHMS_AVAILABLE:
        return critical('digest not available')
    try:
        digest = getattr(hashlib, digest)
        if not digest_size: digest_size = digest().digest_size
    except (AttributeError, TypeError, ValueError):
        return critical('digest creation failed')

    if args.tls_auth:
        # see openvpn source code "src/openvpn/crypto.h", "src/openvpn/crypto.c" and "src/openvpn/crypto_backend.h"
        # 64 byte cipher direction 0, 64 byte hmac direction 0, 64 byte cipher direction 1, 64 byte hmac direction 1 (=> 2048 bit)
        key = readkey(args.tls_auth)
        if key is None or len(key) < 2 * (MAX_CIPHER_KEY_LENGTH + MAX_HMAC_KEY_LENGTH):
            return critical('cannot read tls auth file')
        index_start = MAX_CIPHER_KEY_LENGTH
        hmac_key_0 = key[index_start:index_start + MAX_HMAC_KEY_LENGTH]
        index_start = MAX_CIPHER_KEY_LENGTH + MAX_HMAC_KEY_LENGTH + MAX_CIPHER_KEY_LENGTH
        hmac_key_1 = key[index_start:index_start + MAX_HMAC_KEY_LENGTH]
        # Wie OpenVPN: key-direction 1 sendet mit Schlüssel 1 und prüft mit Schlüssel 0,
        # key-direction 0 umgekehrt, ohne key-direction nutzen beide Seiten Schlüssel 0.
        if key_direction == '1':
            client_key, server_key = hmac_key_1, hmac_key_0
        elif key_direction == '0':
            client_key, server_key = hmac_key_0, hmac_key_1
        else:
            client_key = server_key = hmac_key_0
        # reduce key size to required size
        client_key = client_key[:digest_size]
        server_key = server_key[:digest_size]

    return check(args.host, args.port, args.tcp, args.timeout, digest, digest_size, client_key, server_key, args.retrycount, not args.no_validation, args.family, tls_crypt)

if __name__ == '__main__':
    code = main()
    sys.exit(code)
